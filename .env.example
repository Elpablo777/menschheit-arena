# ============================================================
# Menschheit Arena - Konfiguration
# Kopiere diese Datei nach .env und fuelle die Werte aus.
# Der Demo-Modus funktioniert ohne jeden API-Key.
# ============================================================

# --- Betrieb ---
APP_ENV=local
APP_LANG=de
APP_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/menschheit.db

# --- LLM-Provider ---
# mock | openrouter | deepseek | openai | mistral | ollama | litellm | openai_compat
# "mock" erzeugt deterministische Demo-Debatten ohne Netzwerk und ohne Kosten.
LLM_PROVIDER=mock
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_SECONDS=90

# Modellnamen werden an den Provider durchgereicht.
# Beispiele OpenRouter: anthropic/claude-sonnet-4, deepseek/deepseek-r1, openai/gpt-4o
# Beispiele DeepSeek: deepseek-chat, deepseek-reasoner
ARENA_PRO_MODEL=mock-pro
ARENA_CONTRA_MODEL=mock-contra
ARENA_JUDGE_MODEL=mock-judge
ARENA_MODERATOR_MODEL=mock-moderator

# --- Arena ---
ARENA_DEFAULT_ROUNDS=4
ARENA_MAX_ROUNDS=8
ARENA_WORD_LIMIT=350

# --- Sentinel / Pentest-Control-Plane ---
# Aktive Ausfuehrung ist absichtlich NICHT implementiert.
PENTEST_EXECUTION_ENABLED=false
# Oeffentliche Ziele nur nach schriftlicher RoE und expliziter Freigabe.
ALLOW_PUBLIC_TARGETS=false

# --- Optional: LiteLLM / Postgres ---
# LITELLM_MASTER_KEY=sk-aendern
# DATABASE_URL=postgresql+psycopg://menschheit:passwort@postgres:5432/menschheit
